{
  "name": "asignacion-clases",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/assignment-validation.test.ts tests/error-utils.test.ts tests/reports.test.ts",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:rls": "vitest run tests/integration/supabase-rls.test.ts",
    "test:audit": "vitest run tests/integration/audit-triggers.test.ts",
    "test:security": "vitest run tests/integration/security-hardening.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "backup:db": "tsx scripts/backup-db.ts",
    "env:local": "tsx scripts/configure-local-env.ts",
    "import:datos": "tsx scripts/import-datos.ts",
    "seed": "npm run import:datos",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "supabase:types": "supabase gen types typescript --local > types/supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.107.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-excel-file": "9.0.10",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "postcss": "8.5.15",
    "sharp": "0.35.3"
  }
}
