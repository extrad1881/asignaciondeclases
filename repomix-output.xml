    or upper(required_profile_code) like '%#ERROR%'
  );

delete from public.teacher_profiles
where code is null
   or upper(replace(code, ' ', '')) in ('NAN', 'NULL', 'UNDEFINED')
   or upper(code) like '%#REF%'
   or upper(code) like '%#ERROR%';

commit;
