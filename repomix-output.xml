CREATE OR REPLACE FUNCTION "public"."audit_row_changes"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
declare
  old_doc jsonb := case when tg_op in ('UPDATE', 'DELETE') then to_jsonb(old) else null end;
  new_doc jsonb := case when tg_op in ('INSERT', 'UPDATE') then to_jsonb(new) else null end;
  target_id text;
begin
  target_id := coalesce(new_doc->>'id', old_doc->>'id', md5(coalesce(new_doc::text, old_doc::text)));

  insert into public.audit_logs (user_id, action_type, table_name, record_id, old_value, new_value)
  values (auth.uid(), lower(tg_op), tg_table_name, target_id, old_doc, new_doc);

  return coalesce(new, old);
end;
$$;


ALTER FUNCTION "public"."audit_row_changes"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_access_career"("target_career_id" "uuid") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  select public.is_admin()
    or exists (
      select 1
      from public.coordinator_careers cc
      where cc.coordinator_id = public.current_coordinator_id()
        and cc.career_id = target_career_id
    );
$$;


ALTER FUNCTION "public"."can_access_career"("target_career_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_access_group_subject"("target_group_subject_id" "uuid") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  select exists (
    select 1
    from public.group_subjects gs
    join public.groups g on g.id = gs.group_id
    where gs.id = target_group_subject_id
      and public.can_access_career(g.career_id)
  );
$$;


ALTER FUNCTION "public"."can_access_group_subject"("target_group_subject_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_access_teacher"("target_teacher_id" "uuid") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  select public.is_admin()
    or exists (
      select 1
      from public.coordinator_teachers ct
      where ct.coordinator_id = public.current_coordinator_id()
        and ct.teacher_id = target_teacher_id
    )
    or exists (
      select 1
      from public.teachers t
      where t.id = target_teacher_id
        and t.responsible_coordinator_id = public.current_coordinator_id()
    );
$$;


ALTER FUNCTION "public"."can_access_teacher"("target_teacher_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_manage_assignment"("target_group_subject_id" "uuid", "target_teacher_id" "uuid") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  select public.is_admin()
    or (
      public.can_access_group_subject(target_group_subject_id)
      and public.can_access_teacher(target_teacher_id)
    );
$$;


ALTER FUNCTION "public"."can_manage_assignment"("target_group_subject_id" "uuid", "target_teacher_id" "uuid") OWNER TO "postgres";


