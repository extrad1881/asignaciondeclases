import { ActionStateForm } from "@/components/ui/action-state-form";
import { Button } from "@/components/ui/button";
import { ConfirmActionButton } from "@/components/ui/confirm-action-button";
import { DataTable } from "@/components/ui/data-table";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { MODALITIES, SHIFTS, WEEKDAYS } from "@/lib/constants";
import { isValidProfileCode } from "@/lib/profiles";
import { createClient } from "@/lib/supabase/server";
import { getCurrentProfile } from "@/lib/supabase/queries";
import { formatHours } from "@/lib/utils";

export const dynamic = "force-dynamic";

function requiredProfilesFor(groupSubject: any) {
  if (groupSubject.required_profile_code && isValidProfileCode(groupSubject.required_profile_code)) {
    return [groupSubject.required_profile_code];
  }

  return ((groupSubject.subjects?.class_requirements ?? []) as any[])
    .map((requirement) => requirement.profile_code)
    .filter(isValidProfileCode);
}

function templateLabel(modality: string, shift: string) {
  const modalityLabel = MODALITIES.find((item) => item.value === modality)?.label ?? modality;
  const shiftLabel = SHIFTS.find((item) => item.value === shift)?.label ?? shift;
  return `${modalityLabel} ${shiftLabel}`;
}

export default async function CoordinatorPage() {
  const profile = await getCurrentProfile();
  if (!profile) redirect("/login");
  if (profile.role_code !== "coordinator") redirect("/dashboard");

  const supabase = await createClient();
  const [
    { data: coordinator },
    { data: cycles = [] },
    { data: careers = [] },
    { data: classrooms = [] },
    { data: subjects = [] },
    { data: profiles = [] },
    { data: teachers = [] },
    { data: groups = [] },
    { data: scheduleBlocks = [] }
  ] = await Promise.all([
    supabase.from("coordinators").select("id, name").eq("profile_id", profile.id).maybeSingle(),
    supabase.from("academic_cycles").select("id, code, name").eq("active", true).order("code"),
    supabase.from("careers").select("id, code, name").eq("active", true).order("code"),
    supabase.from("classrooms").select("id, name").eq("active", true).order("name"),
    supabase
      .from("subjects")
      .select("id, name, career_id, quarter, default_hours")
      .eq("active", true)
      .order("quarter")
      .order("name"),
    supabase.from("teacher_profiles").select("code, name").order("code"),
    supabase
      .from("teachers")
      .select("id, name, email, max_hours, assigned_hours, active, teacher_available_profiles(profile_code)")
      .eq("active", true)
      .order("name")
      .limit(300),
    supabase
      .from("groups")
      .select(
        "id, name, quarter, modality, shift, status, academic_cycles(code), careers(code, name), classrooms(name), group_subjects(id, hours_per_week, required_profile_code, subjects(id, name, quarter, class_requirements(profile_code)))"
      )
      .eq("status", "active")
      .order("created_at", { ascending: false })
      .limit(80),
    supabase
      .from("schedule_blocks")
      .select("id, label, starts_at, ends_at, day_of_week, is_custom, created_by, schedule_templates!inner(code, label, modality, shift, asset_path)")
      .eq("active", true)
      .or(`is_custom.eq.false,created_by.eq.${profile.id}`)
      .order("day_of_week")
      .order("starts_at")
  ]);

  const groupRows = groups ?? [];
  const teacherRows = teachers ?? [];
  const profileOptions = (profiles ?? []).filter((teacherProfile: any) => isValidProfileCode(teacherProfile.code));
  const groupSubjectIds = groupRows.flatMap((group: any) => ((group.group_subjects ?? []) as any[]).map((subject) => subject.id));

  const { data: assignments = [] } = groupSubjectIds.length > 0
    ? await supabase
        .from("assignments")
        .select("id, group_subject_id, schedule_block_id, duration_hours, teachers(name), classrooms(id, name), group_subjects(subjects(name))")
        .in("group_subject_id", groupSubjectIds)
        .eq("status", "active")
    : { data: [] };

  const teacherOptions = teacherRows.map((teacher: any) => ({
    id: teacher.id,
    label: `${teacher.name} - ${formatHours(teacher.assigned_hours)} / ${formatHours(teacher.max_hours)} h`,
    profileCodes: ((teacher.teacher_available_profiles ?? []) as any[])
      .map((teacherProfile) => teacherProfile.profile_code)
      .filter(isValidProfileCode)
  }));

  const stats = [
    { label: "Carreras", value: careers?.length ?? 0, icon: LayoutGrid, tone: "bg-blue-50 text-blue-700" },
    { label: "Docentes a cargo", value: teacherRows.length, icon: Users, tone: "bg-emerald-50 text-emerald-700" },
    { label: "Grupos visibles", value: groupRows.length, icon: UserCog, tone: "bg-slate-100 text-slate-700" },
    { label: "Asignaciones", value: assignments?.length ?? 0, icon: Clock, tone: "bg-amber-50 text-amber-700" }
  ];

  return (
    <>
      <SectionHeader eyebrow="Coordinador" title={coordinator?.name ?? "Panel de coordinador"}>
        <Badge tone="info">Permisos por carrera y docentes a cargo</Badge>
      </SectionHeader>

      <section className="mb-6 grid gap-3 md:grid-cols-4">
        {stats.map((item) => {
          const Icon = item.icon;
          return (
            <div className="rounded-md border border-line bg-white p-4 shadow-subtle" key={item.label}>
              <div className={`mb-3 inline-flex rounded-md p-2 ${item.tone}`}>
                <Icon className="h-5 w-5" />
              </div>
              <p className="text-sm text-slate-500">{item.label}</p>
              <p className="text-2xl font-semibold text-ink">{item.value}</p>
            </div>
          );
        })}
      </section>

      <section className="mb-8">
        <div className="mb-3 flex items-center justify-between gap-3">
          <div>
            <h2 className="text-lg font-semibold text-ink">Crear grupo</h2>
            <p className="text-sm text-slate-600">Las carreras y materias disponibles dependen de tu coordinacion asignada.</p>
          </div>
          <Link className="text-sm font-medium text-brand hover:text-teal-800" href="/grupos">
            Ver grupos
          </Link>
        </div>
        <GroupForm
          careers={careers as any[]}
          classrooms={classrooms as any[]}
          canCreateExternalSubjects
          cycles={cycles as any[]}
          profiles={profileOptions as any[]}
          subjects={subjects as any[]}
        />
      </section>

      <section className="mb-8">
        <div className="mb-3">
          <h2 className="text-lg font-semibold text-ink">Docentes a cargo</h2>
          <p className="text-sm text-slate-600">Puedes ajustar perfiles aptos y horas maximas sin cambiar datos generales del docente.</p>
        </div>
        <DataTable
          emptyLabel="No tienes docentes asignados todavia."
          headers={["Docente", "Correo", "Perfiles aptos", "Horas", "Editar perfiles", "Horas maximas"]}
          rows={teacherRows.map((teacher: any) => [
            <span className="font-medium text-ink" key="name">{teacher.name}</span>,
            teacher.email ?? <span className="text-slate-400">Sin correo</span>,
            <div className="flex flex-wrap gap-1" key="profiles">
              {((teacher.teacher_available_profiles ?? []) as any[]).filter((item) => isValidProfileCode(item.profile_code)).length === 0 ? (
                <span className="text-slate-400">Sin perfiles</span>
              ) : (
                ((teacher.teacher_available_profiles ?? []) as any[])
                  .filter((item) => isValidProfileCode(item.profile_code))
                  .map((item) => <Badge key={item.profile_code}>{item.profile_code}</Badge>)
              )}
            </div>,
            `${formatHours(teacher.assigned_hours)} / ${formatHours(teacher.max_hours)}`,
            <form action={updateTeacherProfilesAction} className="grid min-w-56 gap-2" key="profiles-form">
              <input name="teacher_id" type="hidden" value={teacher.id} />
              <ProfileCheckboxGroup
                maxHeight="max-h-36"
                profiles={profileOptions as any[]}
                selected={((teacher.teacher_available_profiles ?? []) as any[])
                  .map((item) => item.profile_code)
                  .filter(isValidProfileCode)}
              />
              <ConfirmActionButton
                action={updateTeacherProfilesFeedbackAction}
                affectedName={teacher.name}
                className="h-8 px-3"
                confirmLabel="Guardar perfiles"
                description="Se reemplazaran los perfiles aptos del docente a tu cargo."
                title="Modificar perfiles del docente"
                variant="secondary"
              >
                <Save className="h-4 w-4" />
                Guardar
              </ConfirmActionButton>
            </form>,
            <form action={updateTeacherMaxHoursAction} className="grid min-w-36 gap-2" key="hours-form">
              <input name="teacher_id" type="hidden" value={teacher.id} />
              <Input defaultValue={teacher.max_hours ?? 20} min={teacher.assigned_hours ?? 0} name="max_hours" step={0.5} type="number" />
              <ConfirmActionButton
                action={updateTeacherMaxHoursFeedbackAction}
                affectedName={teacher.name}
                className="h-8 px-3"
                confirmLabel="Guardar horas"
                description="Se modificara el limite de horas del docente. No puede quedar debajo de las horas ya asignadas."
                title="Modificar horas maximas"
                variant="secondary"
              >
                <Save className="h-4 w-4" />
                Guardar
              </ConfirmActionButton>
            </form>
          ])}
        />
      </section>

      <section className="space-y-7">
        <div>
          <h2 className="text-lg font-semibold text-ink">Dashboard visual de grupos</h2>
          <p className="text-sm text-slate-600">Cada grupo usa el cuadro de horario correspondiente a su modalidad y turno.</p>
        </div>

        {groupRows.length === 0 ? (
          <div className="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
            Todavia no hay grupos activos en tus carreras asignadas.
          </div>
        ) : (
          groupRows.map((group: any) => {
            const groupSubjects = ((group.group_subjects ?? []) as any[]).map((item) => ({
              id: item.id,
              label: `${item.subjects?.name} (${item.hours_per_week ?? 0} h)`,
              requiredProfiles: requiredProfilesFor(item),
              loadHours: Number(item.hours_per_week ?? 1.5)
            }));
            const groupSubjectIdSet = new Set(groupSubjects.map((subject) => subject.id));
            const groupAssignments = ((assignments ?? []) as any[]).filter((assignment) => groupSubjectIdSet.has(assignment.group_subject_id));
            const groupBlocks = ((scheduleBlocks ?? []) as any[])
              .filter((block) => block.schedule_templates?.modality === group.modality && block.schedule_templates?.shift === group.shift)
              .map((block) => ({
                id: block.id,
                label: block.label,
                dayOfWeek: block.day_of_week,
                startsAt: block.starts_at,
                endsAt: block.ends_at,
                isCustom: block.is_custom
              }));
            const assetPath = ((scheduleBlocks ?? []) as any[]).find(
              (block) => block.schedule_templates?.modality === group.modality && block.schedule_templates?.shift === group.shift
            )?.schedule_templates?.asset_path;

            return (
              <section className="space-y-4 border-t border-line pt-6" key={group.id}>
                <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                  <div>
                    <Link className="text-xl font-semibold text-ink hover:text-brand" href={`/grupos/${group.id}`}>
                      {group.name}
                    </Link>
                    <p className="text-sm text-slate-600">
                      {group.careers?.code} - Cuatrimestre {group.quarter} - {templateLabel(group.modality, group.shift)}
                    </p>
                  </div>
                  <Badge tone="success">{group.academic_cycles?.code ?? "Ciclo activo"}</Badge>
                </div>

                <GroupScheduleBoard
                  assetPath={assetPath}
                  assignments={groupAssignments.map((assignment) => ({
                    id: assignment.id,
                    scheduleBlockId: assignment.schedule_block_id,
                    subjectName: assignment.group_subjects?.subjects?.name,
                    teacherName: assignment.teachers?.name,
                    classroomName: assignment.classrooms?.name ?? group.classrooms?.name
                  }))}
                  blocks={groupBlocks}
                />

                <div className="grid gap-4 xl:grid-cols-[1fr_360px]">
                  <div>
                    <h3 className="mb-2 text-base font-semibold text-ink">Asignar docente</h3>
                    <AssignmentForm
                      assignments={groupAssignments.map((assignment) => ({
                        id: assignment.id,
                        scheduleBlockId: assignment.schedule_block_id,
                        subjectName: assignment.group_subjects?.subjects?.name,
                        teacherName: assignment.teachers?.name
                      }))}
                      blocks={groupBlocks}
                      classrooms={(classrooms as any[]).map((classroom) => ({
                        id: classroom.id,
                        label: classroom.name
                      }))}
                      groupSubjects={groupSubjects}
                      teachers={teacherOptions}
                    />

                    <div className="mt-4">
                      <h3 className="mb-2 text-base font-semibold text-ink">Asignaciones activas</h3>
                      <DataTable
                        emptyLabel="Todavia no hay asignaciones en este grupo."
                        headers={["Materia", "Docente", "Bloque", "Horas", "Cambiar", "Eliminar"]}
                        rows={groupAssignments.map((assignment) => [
                          assignment.group_subjects?.subjects?.name,
                          assignment.teachers?.name,
                          groupBlocks.find((block) => block.id === assignment.schedule_block_id)?.label ?? "Sin bloque",
                          `${assignment.duration_hours ?? 0} h`,
                          <form action={updateAssignmentAction} className="grid min-w-[520px] gap-2 md:grid-cols-[1fr_110px_150px_auto]" key="update">
                            <input name="assignment_id" type="hidden" value={assignment.id} />
                            <input name="group_id" type="hidden" value={group.id} />
                            <Select defaultValue={assignment.schedule_block_id ?? ""} name="schedule_block_id" required>
                              {groupBlocks.map((block) => (
                                <option key={block.id} value={block.id}>
                                  {block.label}
                                </option>
                              ))}
                            </Select>
                            <Input
                              defaultValue={assignment.duration_hours ?? 1.5}
                              max={99}
                              min={0.5}
                              name="duration_hours"
                              required
                              step={0.5}
                              type="number"
                            />
                            <Select defaultValue={assignment.classrooms?.id ?? ""} name="classroom_id">
                              <option value="">Aula del grupo</option>
                              {(classrooms as any[]).map((classroom) => (
                                <option key={classroom.id} value={classroom.id}>
                                  {classroom.name}
                                </option>
                              ))}
                            </Select>
                            <ConfirmActionButton
                              action={updateAssignmentFeedbackAction}
                              affectedName={`${assignment.group_subjects?.subjects?.name ?? "Asignacion"} - ${assignment.teachers?.name ?? "Docente"}`}
                              className="h-10 px-3"
                              confirmLabel="Guardar cambio"
                              description="Se modificara el horario, aula y horas de esta asignacion activa."
                              title="Modificar asignacion"
                              variant="secondary"
                            >
                              <Save className="h-4 w-4" />
                              Guardar
                            </ConfirmActionButton>
                          </form>,
                          <form action={deleteAssignmentAction} key="delete">
                            <input name="assignment_id" type="hidden" value={assignment.id} />
                            <input name="group_id" type="hidden" value={group.id} />
                            <ConfirmActionButton
                              action={deleteAssignmentFeedbackAction}
                              affectedName={`${assignment.group_subjects?.subjects?.name ?? "Asignacion"} - ${assignment.teachers?.name ?? "Docente"}`}
                              className="h-10 px-3"
                              confirmLabel="Eliminar asignacion"
                              danger
                              description="La asignacion se eliminara y el docente liberara esas horas."
                              title="Eliminar asignacion"
                            >
                              <Trash2 className="h-4 w-4" />
                              Eliminar
                            </ConfirmActionButton>
                          </form>
                        ])}
                      />
                    </div>
                  </div>

                  <div>
                    <h3 className="mb-2 text-base font-semibold text-ink">Bloque personalizado</h3>
                    <ActionStateForm action={createCustomScheduleBlockStateAction} className="grid gap-3 rounded-md border border-line bg-white p-4 shadow-subtle">
                      <input name="group_id" type="hidden" value={group.id} />
                      <label className="text-sm font-medium text-slate-700">
                        Dia
                        <Select className="mt-1" name="day_of_week" required>
                          {WEEKDAYS.map((day) => (
                            <option key={day.value} value={day.value}>
                              {day.label}
                            </option>
                          ))}
                        </Select>
                      </label>
                      <label className="text-sm font-medium text-slate-700">
                        Inicio
                        <Input className="mt-1" name="starts_at" required type="time" />
                      </label>
                      <label className="text-sm font-medium text-slate-700">
                        Fin
                        <Input className="mt-1" name="ends_at" required type="time" />
                      </label>
                      <Button type="submit" variant="secondary">
                        <CalendarPlus className="h-4 w-4" />
                        Agregar bloque
                      </Button>
                    </ActionStateForm>
                  </div>
                </div>
              </section>
            );
          })
        )}
      </section>
    </>
  );
}
</file>

<file path="app/(dashboard)/coordinadores/page.tsx">
import {
  deleteCoordinatorRecordAction,
  deleteCoordinatorRecordFeedbackAction,
  updateCoordinatorCareersAction,
  updateCoordinatorCareersFeedbackAction,
  updateCoordinatorRecordAction,
  updateCoordinatorRecordFeedbackAction,
  updateCoordinatorUserAction,
  updateCoordinatorUserFeedbackAction
} from "@/app/(dashboard)/actions";
import { SectionHeader } from "@/components/section-header";
import { Badge } from "@/components/ui/badge";
import { ConfirmActionButton } from "@/components/ui/confirm-action-button";
import { DataTable } from "@/components/ui/data-table";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { isAdmin } from "@/lib/permissions";
import { getCurrentProfile } from "@/lib/supabase/queries";
import { createClient } from "@/lib/supabase/server";

export const dynamic = "force-dynamic";

export default async function CoordinatorsPage() {
  const supabase = await createClient();
  const [profile, { data: coordinators = [] }, { data: careers = [] }] = await Promise.all([
    getCurrentProfile(),
    supabase
      .from("coordinators")
      .select(
        "id, profile_id, name, active, users_profile(id, email, display_name, role_code, active), coordinator_careers(career_id, careers(id, code, name, active)), coordinator_teachers(teacher_id)"
      )
      .order("name"),
    supabase.from("careers").select("id, code, name, active").order("code")
  ]);
  const canManageUsers = isAdmin(profile?.role_code);
  const coordinatorRows = coordinators ?? [];
  const careerRows = careers ?? [];

  return (
    <>
      <SectionHeader eyebrow="Usuarios" title="Coordinadores" />
      <DataTable
        headers={
          canManageUsers
            ? [
                "Coordinador",
                "Usuario",
                "Carreras",
                "Modificar carreras",
                "Docentes",
                "Estado",
                "Modificar coordinador",
                "Modificar usuario"
              ]
            : ["Coordinador", "Usuario", "Carreras", "Docentes", "Estado"]
        }
        rows={coordinatorRows.map((coordinator: any) => {
          const assignedCareerIds = new Set(
            (coordinator.coordinator_careers ?? [])
              .map((item: any) => item.career_id ?? item.careers?.id)
              .filter(Boolean)
          );

          return [
            <span className="font-medium text-ink" key="name">
              {coordinator.name}
            </span>,
            coordinator.users_profile?.email ?? <span className="text-slate-400">Sin usuario vinculado</span>,
            <div className="flex flex-wrap gap-1" key="careers">
              {(coordinator.coordinator_careers ?? []).length === 0 ? (
                <span className="text-slate-400">Sin asignar</span>
              ) : (
                (coordinator.coordinator_careers ?? []).map((item: any, index: number) => (
                  <Badge key={index}>{item.careers?.code}</Badge>
                ))
              )}
            </div>,
            ...(canManageUsers
              ? [
                  <form action={updateCoordinatorCareersAction} className="grid min-w-[560px] gap-2" key="edit-careers">
                    <input name="coordinator_id" type="hidden" value={coordinator.id} />
                    <div className="grid max-h-56 gap-2 overflow-y-auto rounded-md border border-line bg-white p-2 md:grid-cols-2">
                      {careerRows.map((career: any) => (
                        <label
                          className="flex items-start gap-2 rounded-md border border-line bg-slate-50 px-2 py-2 text-xs font-medium text-ink"
                          key={career.id}
                        >
                          <input
                            className="mt-0.5 h-4 w-4 accent-brand"
                            defaultChecked={assignedCareerIds.has(career.id)}
                            name="career_ids"
                            type="checkbox"
                            value={career.id}
                          />
                          <span className="grid gap-0.5">
                            <span>{career.code}</span>
                            <span className="font-normal text-slate-500">
                              {career.name}
                              {career.active ? "" : " (Inactiva)"}
                            </span>
                          </span>
                        </label>
                      ))}
                      {careerRows.length === 0 ? <span className="text-sm text-slate-400">Sin carreras</span> : null}
                    </div>
                    <ConfirmActionButton
                      action={updateCoordinatorCareersFeedbackAction}
                      affectedName={coordinator.name}
                      className="h-9 px-3"
                      confirmLabel="Guardar carreras"
                      description="Se reemplazara la lista de carreras asignadas al coordinador por la seleccion actual."
                      title="Modificar carreras del coordinador"
                      variant="secondary"
                    >
                      Guardar carreras
                    </ConfirmActionButton>
                  </form>
                ]
              : []),
            coordinator.coordinator_teachers?.length ?? 0,
            <Badge key="state" tone={coordinator.active ? "success" : "warning"}>
              {coordinator.active ? "Activo" : "Inactivo"}
            </Badge>,
            ...(canManageUsers
              ? [
                  <div className="grid min-w-[460px] gap-2" key="edit-coordinator">
                    <form action={updateCoordinatorRecordAction} className="grid gap-2 md:grid-cols-[1fr_130px_auto]">
                      <input name="coordinator_id" type="hidden" value={coordinator.id} />
                      <Input defaultValue={coordinator.name} name="name" required />
                      <Select defaultValue={coordinator.active ? "true" : "false"} name="active" required>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                      </Select>
                      <ConfirmActionButton
                        action={updateCoordinatorRecordFeedbackAction}
                        affectedName={coordinator.name}
                        className="h-10 px-3"
                        confirmLabel="Guardar coordinador"
                        description="Se actualizaran el nombre y estado operativo del coordinador."
                        title="Modificar coordinador"
                        variant="secondary"
                      >
                        Guardar
                      </ConfirmActionButton>
                    </form>
                    {coordinator.profile_id ? (
                      <span className="text-xs text-slate-400">Con usuario vinculado</span>
                    ) : (
                      <form action={deleteCoordinatorRecordAction}>
                        <input name="coordinator_id" type="hidden" value={coordinator.id} />
                        <ConfirmActionButton
                          action={deleteCoordinatorRecordFeedbackAction}
                          affectedName={coordinator.name}
                          className="h-9 px-3"
                          confirmLabel="Eliminar coordinador"
                          danger
                          description="El registro del coordinador se eliminara. Esta opcion solo aplica cuando no tiene usuario vinculado."
                          title="Eliminar coordinador"
                        >
                          Eliminar coordinador
                        </ConfirmActionButton>
                      </form>
                    )}
                  </div>,
                  coordinator.users_profile?.id ? (
                    <form action={updateCoordinatorUserAction} className="grid min-w-[560px] gap-2" key="edit-user">
                      <input name="coordinator_id" type="hidden" value={coordinator.id} />
                      <input name="user_id" type="hidden" value={coordinator.users_profile.id} />
                      <div className="grid gap-2 md:grid-cols-[1fr_140px_1fr_auto]">
                        <Input defaultValue={coordinator.users_profile.email ?? ""} name="email" required type="email" />
                        <Select defaultValue={(coordinator.users_profile.active ?? coordinator.active) ? "true" : "false"} name="active" required>
                          <option value="true">Activo</option>
                          <option value="false">Inactivo</option>
                        </Select>
                        <Input name="password" placeholder="Nueva contraseña" type="password" />
                        <ConfirmActionButton
                          action={updateCoordinatorUserFeedbackAction}
                          affectedName={coordinator.name}
                          className="h-10 px-3"
                          confirmLabel="Guardar usuario"
                          description="Se actualizara el correo, estado y, si escribiste una nueva, la contrasena del usuario vinculado."
                          title="Modificar usuario del coordinador"
                          variant="secondary"
                        >
                          Guardar
                        </ConfirmActionButton>
                      </div>
                    </form>
                  ) : (
                    <span className="text-sm text-slate-400" key="no-user">
                      Sin usuario para editar
                    </span>
                  )
                ]
              : [])
          ];
        })}
      />
    </>
  );
}
</file>

<file path="app/(dashboard)/docentes/page.tsx">
import { Save, Trash2, UserPlus } from "lucide-react";
import { SectionHeader } from "@/components/section-header";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { ActionStateForm } from "@/components/ui/action-state-form";
import { ConfirmActionButton } from "@/components/ui/confirm-action-button";
import { DataTable } from "@/components/ui/data-table";
import { ProfileCheckboxGroup } from "@/components/forms/profile-checkbox-group";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import {
  assignCoordinatorTeacherAction,
  assignCoordinatorTeacherFeedbackAction,
  createTeacherStateAction,
  setTeacherActiveAction,
  setTeacherActiveFeedbackAction,
  updateTeacherProfilesAction,
  updateTeacherProfilesFeedbackAction
} from "@/app/(dashboard)/actions";
import { createClient } from "@/lib/supabase/server";
import { getCurrentProfile } from "@/lib/supabase/queries";
import { isAdmin } from "@/lib/permissions";
import { isValidProfileCode } from "@/lib/profiles";
import { formatHours } from "@/lib/utils";

export const dynamic = "force-dynamic";

export default async function TeachersPage() {
  const supabase = await createClient();
  const [profile, { data: teachers = [] }, { data: profiles = [] }, { data: coordinators = [] }] = await Promise.all([
    getCurrentProfile(),
    supabase
      .from("teachers")
      .select("id, name, email, max_hours, assigned_hours, active, responsible_coordinator_id, teacher_available_profiles(profile_code)")
      .order("name")
      .limit(300),
    supabase.from("teacher_profiles").select("code, name").order("code"),
    supabase.from("coordinators").select("id, name").eq("active", true).order("name")
  ]);
  const teacherRows = teachers ?? [];
  const canManageTeachers = isAdmin(profile?.role_code);
  const profileOptions = (profiles ?? []).filter((teacherProfile: any) => isValidProfileCode(teacherProfile.code));
  const coordinatorOptions = coordinators ?? [];

  return (
    <>
      <SectionHeader eyebrow="Catálogo" title="Docentes" />
      {canManageTeachers ? (
        <section className="mb-6 rounded-md border border-line bg-white p-4 shadow-subtle">
          <h2 className="mb-3 text-lg font-semibold text-ink">Agregar docente</h2>
          <ActionStateForm action={createTeacherStateAction} className="grid gap-3 md:grid-cols-[1fr_1fr_140px_220px_auto]" alertClassName="md:col-span-full">
            <label className="text-sm font-medium text-slate-700">
              Nombre
              <Input className="mt-1" name="name" placeholder="Nombre del docente" required />
            </label>
            <label className="text-sm font-medium text-slate-700">
              Correo
              <Input className="mt-1" name="email" placeholder="correo@institucion.edu" type="email" />
            </label>
            <label className="text-sm font-medium text-slate-700">
              Horas máximas
              <Input className="mt-1" defaultValue={20} min={0} name="max_hours" required step={0.5} type="number" />
            </label>
            <div className="text-sm font-medium text-slate-700">
              Perfiles aptos
              <div className="mt-1">
                <ProfileCheckboxGroup profiles={profileOptions as any[]} />
              </div>
            </div>
            <div className="flex items-end">
              <Button className="w-full" type="submit">
                <UserPlus className="h-4 w-4" />
                Agregar
              </Button>
            </div>
          </ActionStateForm>
        </section>
      ) : null}
      <DataTable
        headers={
          canManageTeachers
            ? ["Docente", "Correo", "Coordinador", "Perfiles aptos", "Horas", "Estado", "Editar perfiles", "Asignar coordinador", "Acciones"]
            : ["Docente", "Correo", "Coordinador", "Perfiles aptos", "Horas", "Estado"]
        }
        rows={teacherRows.map((teacher: any) => [
          <span className="font-medium text-ink" key="name">{teacher.name}</span>,
          teacher.email ?? <span className="text-slate-400">Sin correo</span>,
          coordinatorOptions.find((coordinator: any) => coordinator.id === teacher.responsible_coordinator_id)?.name ?? (
            <span className="text-slate-400">Sin asignar</span>
          ),
          <div className="flex flex-wrap gap-1" key="profiles">
            {((teacher.teacher_available_profiles ?? []).filter((profile: any) => isValidProfileCode(profile.profile_code))).length === 0 ? (
              <span className="text-slate-400">Sin perfiles</span>
            ) : (
              (teacher.teacher_available_profiles ?? []).filter((profile: any) => isValidProfileCode(profile.profile_code)).map((profile: any) => (
                <Badge key={profile.profile_code}>{profile.profile_code}</Badge>
              ))
            )}
          </div>,
          `${formatHours(teacher.assigned_hours)} / ${formatHours(teacher.max_hours)}`,
          <Badge key="state" tone={teacher.active ? "success" : "warning"}>
            {teacher.active ? "Activo" : "Inactivo"}
          </Badge>,
          ...(canManageTeachers
            ? [
                <form action={updateTeacherProfilesAction} className="grid min-w-56 gap-2" key="profiles-form">
                  <input name="teacher_id" type="hidden" value={teacher.id} />
                  <ProfileCheckboxGroup
                    maxHeight="max-h-36"
                    profiles={profileOptions as any[]}
                    selected={(teacher.teacher_available_profiles ?? [])
                      .map((item: any) => item.profile_code)
                      .filter(isValidProfileCode)}
                  />
                  <ConfirmActionButton
                    action={updateTeacherProfilesFeedbackAction}
                    affectedName={teacher.name}
                    className="h-8 px-3"
                    confirmLabel="Guardar perfiles"
                    description="Se reemplazaran los perfiles aptos del docente. Las proximas asignaciones validaran contra esta lista."
                    title="Modificar perfiles del docente"
                    variant="secondary"
                  >
                    <Save className="h-4 w-4" />
                    Guardar
                  </ConfirmActionButton>
                </form>,
                <form action={assignCoordinatorTeacherAction} className="grid min-w-52 gap-2" key="coordinator-form">
                  <input name="teacher_id" type="hidden" value={teacher.id} />
                  <Select defaultValue={teacher.responsible_coordinator_id ?? coordinatorOptions[0]?.id ?? ""} name="coordinator_id" required>
                    {coordinatorOptions.map((coordinator: any) => (
                      <option key={coordinator.id} value={coordinator.id}>
                        {coordinator.name}
                      </option>
                    ))}
                  </Select>
                  <ConfirmActionButton
                    action={assignCoordinatorTeacherFeedbackAction}
                    affectedName={teacher.name}
                    className="h-8 px-3"
                    confirmLabel="Asignar coordinador"
                    description="El docente quedara bajo el coordinador seleccionado y se ajustara su alcance de gestion."
                    disabled={coordinatorOptions.length === 0}
                    title="Cambiar coordinador del docente"
                    variant="secondary"
                  >
                    Asignar
                  </ConfirmActionButton>
                </form>,
                <form action={setTeacherActiveAction} key="active-form">
                  <input name="teacher_id" type="hidden" value={teacher.id} />
                  <input name="active" type="hidden" value={teacher.active ? "false" : "true"} />
                  <ConfirmActionButton
                    action={setTeacherActiveFeedbackAction}
                    affectedName={teacher.name}
                    className="h-8 px-3"
                    confirmLabel={teacher.active ? "Desactivar docente" : "Reactivar docente"}
                    danger={teacher.active}
                    description={
                      teacher.active
                        ? "El docente dejara de estar disponible para nuevas asignaciones."
                        : "El docente volvera a estar disponible para asignaciones."
                    }
                    title={teacher.active ? "Desactivar docente" : "Reactivar docente"}
                    variant={teacher.active ? "danger" : "secondary"}
                  >
                    {teacher.active ? <Trash2 className="h-4 w-4" /> : null}
                    {teacher.active ? "Quitar" : "Reactivar"}
                  </ConfirmActionButton>
                </form>
              ]
            : [])
        ])}
      />
    </>
  );
}
</file>

<file path="app/(dashboard)/grupos/[id]/page.tsx">
import { notFound } from "next/navigation";
import { CalendarPlus, CheckCircle2, Inbox, PenLine, Save, Send, Trash2 } from "lucide-react";
import {
  createCustomScheduleBlockStateAction,
  deleteAssignmentAction,
  deleteAssignmentFeedbackAction,
  deleteGroupAction,
  deleteGroupFeedbackAction,
  setGroupArchivedAction,
  setGroupDraftAction,
  setGroupFinalAction,
  setGroupReviewAction,
  updateAssignmentAction,
  updateAssignmentFeedbackAction
} from "@/app/(dashboard)/actions";
import { SectionHeader } from "@/components/section-header";
import { Badge } from "@/components/ui/badge";
import { ActionStateForm } from "@/components/ui/action-state-form";
import { Button } from "@/components/ui/button";
import { ConfirmActionButton } from "@/components/ui/confirm-action-button";
import { DataTable } from "@/components/ui/data-table";
import { AssignmentForm } from "@/components/forms/assignment-form";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { WEEKDAYS } from "@/lib/constants";
import { createClient } from "@/lib/supabase/server";
import { getGroupAuditHistory } from "@/lib/supabase/audit";
import { getCurrentProfile } from "@/lib/supabase/queries";
import { isAdmin } from "@/lib/permissions";
import { isValidProfileCode } from "@/lib/profiles";

export const dynamic = "force-dynamic";

export default async function GroupDetailPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const supabase = await createClient();
  const { data: group } = await supabase
    .from("groups")
    .select(
      "id, name, quarter, modality, shift, status, academic_cycles(code), careers(code, name), classrooms(name), group_subjects(id, hours_per_week, required_profile_code, subjects(id, name, quarter, class_requirements(profile_code)))"
    )
    .eq("id", id)
    .single();

  if (!group) notFound();

  const profile = await getCurrentProfile();
  let blocksQuery = supabase
    .from("schedule_blocks")
    .select("id, label, starts_at, ends_at, day_of_week, is_custom, created_by, schedule_templates!inner(modality, shift)")
    .eq("schedule_templates.modality", (group as any).modality)
    .eq("schedule_templates.shift", (group as any).shift)
    .eq("active", true)
    .order("day_of_week")
    .order("starts_at");

  if (!isAdmin(profile?.role_code) && profile?.id) {
    blocksQuery = blocksQuery.or(`is_custom.eq.false,created_by.eq.${profile.id}`);
  }

  const [
    { data: teachers = [] },
    { data: classrooms = [] },
    { data: blocks = [] },
    { data: assignments = [] }
  ] =
    await Promise.all([
      supabase
        .from("teachers")
        .select("id, name, max_hours, assigned_hours, teacher_available_profiles(profile_code)")
        .eq("active", true)
        .order("name"),
      supabase.from("classrooms").select("id, name").eq("active", true).order("name"),
      blocksQuery,
      supabase
        .from("assignments")
        .select("id, status, duration_hours, classrooms(id, name), teachers(name), schedule_blocks(id, label), group_subjects(id, subjects(name))")
        .in(
          "group_subject_id",
          ((group as any).group_subjects ?? []).map((subject: any) => subject.id)
        )
        .eq("status", "active")
    ]);

  const groupSubjects = ((group as any).group_subjects ?? []).map((item: any) => {
    const requiredProfiles = item.required_profile_code && isValidProfileCode(item.required_profile_code)
      ? [item.required_profile_code]
      : ((item.subjects?.class_requirements ?? []) as any[])
          .map((requirement) => requirement.profile_code)
          .filter(isValidProfileCode);

    return {
      id: item.id,
      label: `${item.subjects?.name} (${item.hours_per_week ?? 0} h)`,
      requiredProfiles,
      loadHours: Number(item.hours_per_week ?? 1.5)
    };
  });
  const groupHistory = await getGroupAuditHistory((group as any).id);

  function auditDetails(value: Record<string, unknown> | null) {
    if (!value) return <span className="text-slate-400">Sin datos</span>;
    return (
      <pre className="max-h-48 overflow-auto rounded-md bg-slate-950 p-3 text-xs text-slate-50">
        {JSON.stringify(value, null, 2)}
      </pre>
    );
  }

  return (
    <>
      <SectionHeader eyebrow="Grupo" title={(group as any).name}>
        <div className="flex items-center gap-2">
          <Badge tone={(group as any).status === "final" ? "success" : (group as any).status === "archived" ? "neutral" : (group as any).status === "review" ? "warning" : "info"}>
            {(group as any).status === "draft" ? "Borrador" : (group as any).status === "review" ? "Revision" : (group as any).status === "final" ? "Finalizado" : "Archivado"}
          </Badge>
          <Badge tone="info">
            {(group as any).shift === "matutino" ? "MAT" : "VES"} {(group as any).quarter}
          </Badge>
        </div>
        {isAdmin(profile?.role_code) ? (
          <form action={deleteGroupAction}>
            <input name="group_id" type="hidden" value={(group as any).id} />
            <ConfirmActionButton
              action={deleteGroupFeedbackAction}
              affectedName={(group as any).name}
              confirmLabel="Borrar grupo"
              danger
              description="Se eliminara el grupo junto con sus materias y asignaciones asociadas si la base lo permite."
              title="Borrar grupo"
            >
              <Trash2 className="h-4 w-4" />
              Borrar grupo
            </ConfirmActionButton>
          </form>
        ) : null}
      </SectionHeader>

      <section className="mb-5 grid gap-3 rounded-md border border-line bg-white p-4 text-sm shadow-subtle md:grid-cols-4">
        <p><span className="font-semibold">Ciclo:</span> {(group as any).academic_cycles?.code}</p>
        <p><span className="font-semibold">Carrera:</span> {(group as any).careers?.code}</p>
        <p><span className="font-semibold">Modalidad:</span> {(group as any).modality}</p>
        <p><span className="font-semibold">Aula:</span> {(group as any).classrooms?.name ?? "Sin aula"}</p>
      </section>

      <section className="mb-5 flex flex-wrap gap-2 rounded-md border border-line bg-white p-3 shadow-subtle">
        <span className="mr-2 self-center text-xs font-semibold uppercase text-slate-500">Estado:</span>
        {(group as any).status === "draft" ? (
          <form action={setGroupReviewAction}>
            <input name="group_id" type="hidden" value={(group as any).id} />
            <Button className="h-8 text-xs" type="submit" variant="secondary">
              <Send className="h-3 w-3" />
              Enviar a revision
            </Button>
          </form>
        ) : null}
        {(group as any).status === "review" ? (
          <>
            <form action={setGroupDraftAction}>
              <input name="group_id" type="hidden" value={(group as any).id} />
              <Button className="h-8 text-xs" type="submit" variant="secondary">
                <PenLine className="h-3 w-3" />
                Volver a borrador
              </Button>
            </form>
            <form action={setGroupFinalAction}>
              <input name="group_id" type="hidden" value={(group as any).id} />
              <Button className="h-8 text-xs" type="submit">
                <CheckCircle2 className="h-3 w-3" />
                Finalizar grupo
              </Button>
            </form>
          </>
        ) : null}
        {(group as any).status === "final" ? (
          <form action={setGroupArchivedAction}>
            <input name="group_id" type="hidden" value={(group as any).id} />
            <Button className="h-8 text-xs" type="submit" variant="secondary">
              <Inbox className="h-3 w-3" />
              Archivar grupo
            </Button>
          </form>
        ) : null}
        {(group as any).status !== "archived" ? null : null}
      </section>

      <section className="space-y-4">
        <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <h2 className="text-lg font-semibold text-ink">Asignar docente</h2>
            <p className="text-sm text-slate-600">
              Selecciona la materia, el docente apto y el bloque visual del cuadro correspondiente.
            </p>
          </div>
          <ActionStateForm action={createCustomScheduleBlockStateAction} className="grid gap-2 rounded-md border border-line bg-white p-3 shadow-subtle md:min-w-[520px] md:grid-cols-[150px_120px_120px_auto]" alertClassName="md:col-span-full">
            <input name="group_id" type="hidden" value={(group as any).id} />
            <label className="text-xs font-semibold uppercase text-slate-600">
              Dia
              <Select className="mt-1 h-9" name="day_of_week" required>
                {WEEKDAYS.map((day) => (
                  <option key={day.value} value={day.value}>
                    {day.label}
                  </option>
                ))}
              </Select>
            </label>
            <label className="text-xs font-semibold uppercase text-slate-600">
              Inicio
              <Input className="mt-1 h-9" name="starts_at" required type="time" />
            </label>
            <label className="text-xs font-semibold uppercase text-slate-600">
              Fin
              <Input className="mt-1 h-9" name="ends_at" required type="time" />
            </label>
            <div className="flex items-end">
              <Button className="h-9 w-full px-3" type="submit" variant="secondary">
                <CalendarPlus className="h-4 w-4" />
                Bloque
              </Button>
            </div>
          </ActionStateForm>
        </div>

        <div>
            <AssignmentForm
              blocks={(blocks as any[]).map((block) => ({
                id: block.id,
                label: block.label,
                dayOfWeek: block.day_of_week,
                startsAt: block.starts_at,
                endsAt: block.ends_at,
                isCustom: block.is_custom
              }))}
              classrooms={(classrooms as any[]).map((classroom) => ({
                id: classroom.id,
                label: classroom.name
              }))}
              assignments={(assignments as any[]).map((assignment) => ({
                id: assignment.id,
                scheduleBlockId: assignment.schedule_blocks?.id,
                subjectName: assignment.group_subjects?.subjects?.name,
                teacherName: assignment.teachers?.name
              }))}
              groupSubjects={groupSubjects}
              teachers={(teachers as any[]).map((teacher) => ({
                id: teacher.id,
                label: `${teacher.name} · ${teacher.assigned_hours ?? 0}/${teacher.max_hours ?? 0} h`,
                profileCodes: ((teacher.teacher_available_profiles ?? []) as any[])
                  .map((teacherProfile) => teacherProfile.profile_code)
                  .filter(isValidProfileCode)
              }))}
            />
        </div>

        <div>
          <h2 className="mb-3 text-lg font-semibold text-ink">Asignaciones activas</h2>
          <DataTable
            headers={["Materia", "Docente", "Bloque", "Horas", "Cambiar", "Eliminar", "Historial"]}
            rows={(assignments as any[]).map((assignment) => [
              assignment.group_subjects?.subjects?.name,
              assignment.teachers?.name,
              assignment.schedule_blocks?.label,
              `${assignment.duration_hours ?? 0} h`,
              <form action={updateAssignmentAction} className="grid min-w-[520px] gap-2 md:grid-cols-[1fr_110px_150px_auto]" key="update">
                <input name="assignment_id" type="hidden" value={assignment.id} />
                <input name="group_id" type="hidden" value={(group as any).id} />
                <Select defaultValue={assignment.schedule_blocks?.id ?? ""} name="schedule_block_id" required>
                  {(blocks as any[]).map((block) => (
                    <option key={block.id} value={block.id}>
                      {block.label}
                    </option>
                  ))}
                </Select>
                <Input
                  defaultValue={assignment.duration_hours ?? 1.5}
                  max={99}
                  min={0.5}
                  name="duration_hours"
                  required
                  step={0.5}
                  type="number"
                />
                <Select defaultValue={assignment.classrooms?.id ?? ""} name="classroom_id">
                  <option value="">Aula del grupo</option>
                  {(classrooms as any[]).map((classroom) => (
                    <option key={classroom.id} value={classroom.id}>
                      {classroom.name}
                    </option>
                  ))}
                </Select>
                <ConfirmActionButton
                  action={updateAssignmentFeedbackAction}
                  affectedName={`${assignment.group_subjects?.subjects?.name ?? "Asignacion"} - ${assignment.teachers?.name ?? "Docente"}`}
                  className="h-10 px-3"
                  confirmLabel="Guardar cambio"
                  description="Se modificara el horario, aula y horas de esta asignacion activa."
                  title="Modificar asignacion"
                  variant="secondary"
                >
                  <Save className="h-4 w-4" />
                  Guardar
                </ConfirmActionButton>
              </form>,
              <form action={deleteAssignmentAction} key="delete">
                <input name="assignment_id" type="hidden" value={assignment.id} />
                <input name="group_id" type="hidden" value={(group as any).id} />
                <ConfirmActionButton
                  action={deleteAssignmentFeedbackAction}
                  affectedName={`${assignment.group_subjects?.subjects?.name ?? "Asignacion"} - ${assignment.teachers?.name ?? "Docente"}`}
                  className="h-10 px-3"
                  confirmLabel="Eliminar asignacion"
                  danger
                  description="La asignacion se eliminara y el docente liberara esas horas."
                  title="Eliminar asignacion"
                >
                  <Trash2 className="h-4 w-4" />
                  Eliminar
                </ConfirmActionButton>
              </form>,
              <details className="min-w-64 text-sm" key="history">
                <summary className="cursor-pointer font-medium text-brand">Ver historial</summary>
                <div className="mt-2 space-y-2">
                  {groupHistory.filter((entry) => entry.table_name === "assignments" && entry.record_id === assignment.id).length === 0 ? (
                    <p className="text-slate-500">Sin eventos auditados.</p>
                  ) : (
                    groupHistory
                      .filter((entry) => entry.table_name === "assignments" && entry.record_id === assignment.id)
                      .map((entry) => (
                        <div className="rounded-md border border-line bg-white p-2" key={entry.id}>
                          <p className="font-medium text-ink">{entry.dateLabel}</p>
                          <p className="text-xs text-slate-500">{entry.actionLabel} - {entry.userLabel}</p>
                          <p className="mt-1 text-xs text-slate-600">{entry.summary}</p>
                        </div>
                      ))
                  )}
                </div>
              </details>
            ])}
          />
        </div>
      </section>

      <section className="mt-8">
        <h2 className="mb-3 text-lg font-semibold text-ink">Historial del grupo</h2>
        <DataTable
          emptyLabel="Todavia no hay eventos auditados para este grupo."
          headers={["Fecha", "Usuario", "Accion", "Tabla", "Resumen", "Valores"]}
          rows={groupHistory.map((entry) => [
            entry.dateLabel,
            entry.userLabel,
            entry.actionLabel,
            entry.table_name,
            entry.summary,
            <details className="min-w-80" key={entry.id}>
              <summary className="cursor-pointer text-sm font-medium text-brand">Ver valores</summary>
              <div className="mt-2 grid gap-2">
                <div>
                  <p className="mb-1 text-xs font-semibold uppercase text-slate-500">Anterior</p>
                  {auditDetails(entry.old_value)}
                </div>
                <div>
                  <p className="mb-1 text-xs font-semibold uppercase text-slate-500">Nuevo</p>
                  {auditDetails(entry.new_value)}
                </div>
              </div>
            </details>
          ])}
        />
      </section>
    </>
  );
}
</file>

