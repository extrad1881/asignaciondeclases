<file path="components/groups/saved-groups.tsx">
import Link from "next/link";
import { Trash2 } from "lucide-react";
import { deleteGroupAction } from "@/app/(dashboard)/actions";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";

type SavedGroup = {
  id: string;
  name: string;
  quarter: number;
  modality: string;
  shift: string;
  academic_cycles?: { code?: string | null } | null;
  careers?: { code?: string | null; name?: string | null } | null;
};

function groupKey(group: SavedGroup) {
  const shift = group.shift === "matutino" ? "MAT" : "VES";
  return `${shift} ${group.quarter}`;
}

export function SavedGroups({ groups, canDelete = false }: { groups: SavedGroup[]; canDelete?: boolean }) {
  const activeGroups = groups.filter(Boolean);
  const buckets = new Map<string, SavedGroup[]>();

  for (const group of activeGroups) {
    const key = [
      group.academic_cycles?.code ?? "Sin ciclo",
      group.modality,
      groupKey(group)
    ].join(" / ");
    buckets.set(key, [...(buckets.get(key) ?? []), group]);
  }

  if (buckets.size === 0) {
    return (
      <div className="rounded-md border border-line bg-white p-6 text-sm text-slate-600 shadow-subtle">
        No hay grupos activos todavía.
      </div>
    );
  }

  return (
    <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {Array.from(buckets.entries()).map(([key, bucket]) => (
        <section className="rounded-md border border-line bg-white p-4 shadow-subtle" key={key}>
          <div className="mb-3 flex items-center justify-between gap-2">
            <h2 className="text-base font-semibold text-ink">{key}</h2>
            <Badge tone="success">{bucket.length} activo(s)</Badge>
          </div>
          <div className="space-y-2">
            {bucket.map((group) => (
              <div className="flex items-center gap-2" key={group.id}>
                <Link
                  className="min-w-0 flex-1 rounded-md border border-line bg-slate-50 px-3 py-2 text-sm hover:bg-slate-100"
                  href={`/grupos/${group.id}`}
                >
                  <span className="font-medium text-ink">{group.name}</span>
                  <span className="ml-2 text-slate-500">{group.careers?.code ?? group.careers?.name}</span>
                </Link>
                {canDelete ? (
                  <form action={deleteGroupAction}>
                    <input name="group_id" type="hidden" value={group.id} />
                    <Button
                      aria-label={`Borrar ${group.name}`}
                      className="h-10 w-10 px-0"
                      title={`Borrar ${group.name}`}
                      type="submit"
                      variant="danger"
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </form>
                ) : null}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  );
}
</file>

<file path="components/schedule/group-schedule-board.tsx">
import Image from "next/image";
import { Badge } from "@/components/ui/badge";
import { WEEKDAYS } from "@/lib/constants";

export type VisualScheduleBlock = {
  id: string;
  label: string;
  dayOfWeek: number;
  startsAt: string;
  endsAt: string;
  isCustom?: boolean;
};

export type VisualScheduleAssignment = {
  id: string;
  scheduleBlockId: string;
  subjectName?: string | null;
  teacherName?: string | null;
  classroomName?: string | null;
};

type TimeRow = {
  key: string;
  startsAt: string;
  endsAt: string;
  kind: "class" | "break";
};

function formatTime(value: string) {
  return value.slice(0, 5);
}

function buildTimeRows(blocks: VisualScheduleBlock[]): TimeRow[] {
  const classRows = Array.from(
    new Map(
      blocks
        .map((block) => ({
          key: `${formatTime(block.startsAt)}-${formatTime(block.endsAt)}`,
          startsAt: formatTime(block.startsAt),
          endsAt: formatTime(block.endsAt),
          kind: "class" as const
        }))
        .map((block) => [block.key, block])
    ).values()
  ).sort((a, b) => a.startsAt.localeCompare(b.startsAt));

  return classRows.flatMap((row, index) => {
    const previous = classRows[index - 1];
    if (!previous || previous.endsAt >= row.startsAt) return [row];
    return [
      {
        key: `break-${previous.endsAt}-${row.startsAt}`,
        startsAt: previous.endsAt,
        endsAt: row.startsAt,
        kind: "break" as const
      },
      row
    ];
  });
}

export function GroupScheduleBoard({
  assetPath,
  blocks,
  assignments
}: {
  assetPath?: string | null;
  blocks: VisualScheduleBlock[];
  assignments: VisualScheduleAssignment[];
}) {
  const days = WEEKDAYS.filter((day) => blocks.some((block) => block.dayOfWeek === day.value));
  const timeRows = buildTimeRows(blocks);

  return (
    <div className="space-y-3">
      {assetPath ? (
        <div className="relative overflow-hidden rounded-md border border-line bg-slate-50">
          <Image alt="Cuadro de horario" className="h-auto w-full object-contain" height={220} src={assetPath} width={1500} />
        </div>
      ) : null}

      <div className="overflow-x-auto rounded-md border border-line bg-white">
        {blocks.length === 0 ? (
          <p className="p-4 text-sm text-slate-500">No hay bloques disponibles.</p>
        ) : (
          <table className="w-full min-w-[760px] border-collapse text-sm">
            <thead>
              <tr className="bg-slate-100 text-left text-xs uppercase text-slate-600">
                <th className="w-32 px-3 py-3 font-semibold">Hora</th>
                {days.map((day) => (
                  <th className="px-3 py-3 font-semibold" key={day.value}>
                    {day.short}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {timeRows.map((time) => (
                <tr className="border-t border-line" key={time.key}>
                  <th className="bg-slate-50 px-3 py-3 text-left text-xs font-semibold text-slate-600">
                    {time.kind === "break" ? "RECESO" : `${time.startsAt} - ${time.endsAt}`}
                  </th>
                  {time.kind === "break" ? (
                    <td className="bg-amber-50 px-3 py-3 text-center text-xs font-semibold uppercase text-amber-700" colSpan={days.length}>
                      Receso {time.startsAt} - {time.endsAt}
                    </td>
                  ) : (
                  days.map((day) => {
                    const block = blocks.find(
                      (item) =>
                        item.dayOfWeek === day.value &&
                        formatTime(item.startsAt) === time.startsAt &&
                        formatTime(item.endsAt) === time.endsAt
                    );
                    const blockAssignments = assignments.filter((assignment) => assignment.scheduleBlockId === block?.id);

                    return (
                      <td className="h-24 border-l border-line p-2 align-top" key={day.value}>
                        {block ? (
                          <div className="grid gap-1 text-xs text-slate-600">
                            <div className="flex flex-wrap items-center gap-1">
                              <span className="font-medium text-ink">{block.label}</span>
                              {block.isCustom ? <Badge tone="warning">Personalizado</Badge> : null}
                            </div>
                            {blockAssignments.length > 0 ? (
                              blockAssignments.map((assignment) => (
                                <div className="rounded-md border border-blue-100 bg-blue-50 p-2 text-blue-900" key={assignment.id}>
                                  <p className="font-semibold">{assignment.subjectName}</p>
                                  <p>{assignment.teacherName}</p>
                                  {assignment.classroomName ? <p className="text-blue-700">{assignment.classroomName}</p> : null}
                                </div>
                              ))
                            ) : (
                              <span className="text-slate-400">Libre</span>
                            )}
                          </div>
                        ) : (
                          <span className="text-xs text-slate-300">No aplica</span>
                        )}
                      </td>
                    );
                  })
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  );
}
</file>

<file path="components/schedule/schedule-grid.tsx">
import Image from "next/image";
import { WEEKDAYS } from "@/lib/constants";
import { findScheduleTemplate, type ScheduleTemplateConfig } from "@/lib/schedule/templates";
import { Badge } from "@/components/ui/badge";

type AssignmentView = {
  id: string;
  schedule_block_id: string;
  teacher_name?: string | null;
  subject_name?: string | null;
  group_name?: string | null;
  classroom_name?: string | null;
};

type TimeRow = {
  key: string;
  startsAt: string;
  endsAt: string;
  kind: "class" | "break";
};

function buildTimeRows(blocks: { startsAt: string; endsAt: string }[]): TimeRow[] {
  const classRows = Array.from(
    new Map(
      blocks
        .map((block) => ({
          key: `${block.startsAt}-${block.endsAt}`,
          startsAt: block.startsAt,
          endsAt: block.endsAt,
          kind: "class" as const
        }))
        .map((block) => [block.key, block])
    ).values()
  ).sort((a, b) => a.startsAt.localeCompare(b.startsAt));

  return classRows.flatMap((row, index) => {
    const previous = classRows[index - 1];
    if (!previous || previous.endsAt >= row.startsAt) return [row];
    return [
      {
        key: `break-${previous.endsAt}-${row.startsAt}`,
        startsAt: previous.endsAt,
        endsAt: row.startsAt,
        kind: "break" as const
      },
      row
    ];
  });
}

export function ScheduleGrid({
  modality,
  shift,
  assignments = [],
  template: providedTemplate
}: {
  modality: string;
  shift: string;
  assignments?: AssignmentView[];
  template?: ScheduleTemplateConfig;
}) {
  const template = providedTemplate ?? findScheduleTemplate(modality, shift);
  if (!template) {
    return (
      <div className="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        No existe plantilla para esta modalidad y turno.
      </div>
    );
  }

  const days = WEEKDAYS.filter((day) =>
    template.blocks.some((block) => block.dayOfWeek === day.value)
  );
  const uniqueTimes = buildTimeRows(template.blocks);

  return (
    <section className="space-y-4">
      <div className="rounded-md border border-line bg-white p-3 shadow-subtle">
        <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 className="text-lg font-semibold text-ink">{template.label}</h2>
            <p className="text-sm text-slate-600">Base visual tomada de la carpeta assets.</p>
          </div>
          <Badge tone="info">{template.code}</Badge>
        </div>
        <div className="relative overflow-hidden rounded-md border border-line bg-slate-50">
          <Image
            alt={`Plantilla ${template.label}`}
            className="h-auto w-full object-contain"
            height={260}
            src={template.asset}
            width={1500}
          />
        </div>
      </div>

      <div className="overflow-x-auto rounded-md border border-line bg-white shadow-subtle">
        <table className="w-full min-w-[840px] border-collapse text-sm">
          <thead className="bg-slate-100 text-slate-700">
            <tr>
              <th className="w-36 px-3 py-3 text-left font-semibold">Bloque</th>
              {days.map((day) => (
                <th className="px-3 py-3 text-left font-semibold" key={day.value}>
                  {day.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {uniqueTimes.map((time) => (
              <tr className="border-t border-line" key={`${time.startsAt}-${time.endsAt}`}>
                <th className="bg-slate-50 px-3 py-3 text-left font-medium text-slate-700">
                  {time.kind === "break" ? "RECESO" : `${time.startsAt} - ${time.endsAt}`}
                </th>
                {time.kind === "break" ? (
                  <td className="bg-amber-50 px-3 py-3 text-center text-xs font-semibold uppercase text-amber-700" colSpan={days.length}>
                    Receso {time.startsAt} - {time.endsAt}
                  </td>
                ) : (
                days.map((day) => {
                  const block = template.blocks.find(
                    (item) =>
                      item.dayOfWeek === day.value &&
                      item.startsAt === time.startsAt &&
                      item.endsAt === time.endsAt
                  );
                  const blockAssignments = assignments.filter(
                    (assignment) => assignment.schedule_block_id === block?.label
                  );

                  return (
                    <td className="h-24 border-l border-line px-3 py-3 align-top" key={day.value}>
                      {blockAssignments.length > 0 ? (
                        <div className="space-y-2">
                          {blockAssignments.map((assignment) => (
                            <div
                              className="rounded-md border border-blue-100 bg-blue-50 p-2 text-xs text-blue-900"
                              key={assignment.id}
                            >
                              <p className="font-semibold">{assignment.subject_name}</p>
                              <p>{assignment.teacher_name}</p>
                              <p className="text-blue-700">{assignment.group_name}</p>
                            </div>
                          ))}
                        </div>
                      ) : (
                        <span className="text-xs text-slate-400">{block?.label ?? "No aplica"}</span>
                      )}
                    </td>
                  );
                })
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  );
}
