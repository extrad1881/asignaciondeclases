  { href: "/reportes", label: "Reportes", icon: FileText },
  { href: "/datos-incompletos", label: "Datos incompletos", icon: CircleAlert, adminOnly: true },
  { href: "/admin", label: "Admin", icon: Settings, adminOnly: true }
];

async function signOut() {
